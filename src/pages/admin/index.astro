---
import { adminContext, verifyAdmin } from '../../lib/os/auth';
import { dashboard } from '../../lib/os/catalogue';
export const prerender = false;
const { env, db } = adminContext(Astro.locals);
const identity = await verifyAdmin(Astro.request, env ?? {});
if (!identity) return new Response('Acceso administrativo no autorizado', { status: 401, headers: { 'content-type': 'text/plain; charset=utf-8', 'cache-control': 'no-store' } });
let counts: Record<string, number> | null = null;
try { if (db) counts = await dashboard(db); } catch (error) { console.error('[os/admin]', error); }
const sections = [{ key: 'productos', label: 'Productos' }, { key: 'personajes', label: 'Personajes' }, { key: 'ediciones', label: 'Ediciones' }];
---
<!doctype html><html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>3DPrintCatalogue OS · Administración</title><style>
:root{font-family:Inter,ui-sans-serif,system-ui,sans-serif;color-scheme:dark;background:#0b1220;color:#f0f4ff}*{box-sizing:border-box}body{margin:0}.shell{max-width:1180px;margin:auto;padding:clamp(20px,5vw,64px)}header{display:flex;justify-content:space-between;align-items:center;gap:20px;border-bottom:1px solid #29354a;padding-bottom:24px}a{color:#a8d4ff}h1{font-size:clamp(28px,4vw,48px);letter-spacing:-.04em;margin:30px 0 8px}.muted{color:#aab9cd}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;margin-top:32px}.card{display:block;border:1px solid #2c3a52;background:#152238;border-radius:18px;padding:24px;text-decoration:none;color:inherit;transition:background .15s,border-color .15s}.card:hover,.card:focus-visible{background:#1d304c;border-color:#6aaeea}.count{font-size:36px;font-weight:750;margin:12px 0}.pill{font-size:12px;color:#9dd7b0}.notice{border:1px solid #7e6336;border-radius:12px;padding:16px;background:#302617;margin-top:24px}footer{margin-top:40px;color:#aab9cd;font-size:13px}
</style></head><body><div class="shell"><header><strong>3DPrintCatalogue <span style="color:#7cc4ff">OS</span></strong><a href="/">Volver al catálogo</a></header><main><h1>Centro de administración</h1><p class="muted">Datos consultados directamente de D1. Acceso protegido por Cloudflare Access y lista de administradores.</p>{!counts && <div class="notice" role="status">No hay métricas disponibles. Comprueba el binding D1 y el esquema; no se muestran datos simulados.</div>}<div class="cards">{sections.map(s => <a class="card" href={`/admin/${s.key}`}><span class="pill">CATÁLOGO</span><h2>{s.label}</h2><div class="count">{counts ? counts[s.key].toLocaleString('es-MX') : '—'}</div><span class="muted">Explorar registros →</span></a>)}</div></main><footer>Acceso: {identity.email} · Operaciones de escritura bloqueadas hasta validar el esquema real.</footer></div></body></html>
