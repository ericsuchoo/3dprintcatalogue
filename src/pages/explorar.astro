
---
import Layout from "../layouts/Layout.astro";
import NewPageWrapper from "../components/home-page/PageWrapperfil";

type PersonajeRow = {
  id_personaje: number | string;
  nombre_personaje: string;
  id_universo?: number | null;
  productsCount?: number;
  img_personaje?: string | null;
};

type UniversoRow = {
  id_universo: number | string;
  nombre_universo: string;
  img_universo?: string | null;
};

type EtiquetaRow = {
  id_etiqueta: string;
  nombre_etiqueta: string;
};

type CategoryCard = {
  meta: {
    id_personaje?: number | string;
    title: string;
    slug: string;
    gallery: { url: string }[];
  };
  productsCount: number;
};

type UniverseCard = {
  id: string;
  title: string;
  imageUrl: string | null;
};

type OriginItem = {
  id: string;
  label: string;
};

type ProductMode = "all" | "cosplay" | "figura";

function slugify(s: string) {
  return s
    .toString()
    .normalize("NFKD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase()
    .trim()
    .replace(/\s+/g, "-")
    .replace(/[^\w-]+/g, "")
    .replace(/--+/g, "-");
}

const db = Astro.locals.runtime.env.DB as any;

const universoId = Astro.url.searchParams.get("universoId");
const origenId = Astro.url.searchParams.get("origenId");
const tipoProductoParam = Astro.url.searchParams.get("tipoProducto");
const verTodos = Astro.url.searchParams.get("todos") === "1";

const productMode: ProductMode =
  tipoProductoParam === "cosplay"
    ? "cosplay"
    : tipoProductoParam === "figura"
      ? "figura"
      : "all";

const discoveryMode =
  !verTodos &&
  !universoId &&
  !origenId &&
  productMode === "all";

const ITEMS_PER_PAGE = 24;
const DISCOVERY_ITEMS = 10;

const requestedPageRaw = Number(
  Astro.url.searchParams.get("page") || "1"
);

const requestedPage =
  Number.isSafeInteger(requestedPageRaw) && requestedPageRaw > 0
    ? requestedPageRaw
    : 1;

let categories: CategoryCard[] = [];
let universos: UniverseCard[] = [];
let origins: OriginItem[] = [];

let universoNombre: string | null = null;
let origenNombre: string | null = null;

let totalCharacters = 0;
let totalPages = 1;
let currentPage = 1;

const buildExploreUrl = (next: {
  universoId?: string | null;
  origenId?: string | null;
  tipoProducto?: ProductMode | null;
  todos?: boolean;
  page?: number | null;
}) => {
  const params = new URLSearchParams();

  if (next.universoId) {
    params.set("universoId", next.universoId);
  }

  if (next.origenId) {
    params.set("origenId", next.origenId);
  }

  if (next.tipoProducto && next.tipoProducto !== "all") {
    params.set("tipoProducto", next.tipoProducto);
  }

  if (next.todos) {
    params.set("todos", "1");
  }

  if (next.page && next.page > 1) {
    params.set("page", String(next.page));
  }

  const query = params.toString();
  return `/explorar${query ? `?${query}` : ""}`;
};

const nextProductMode: ProductMode =
  productMode === "all"
    ? "cosplay"
    : productMode === "cosplay"
      ? "figura"
      : "all";

const productModeToggleHref = buildExploreUrl({
  universoId,
  origenId,
  tipoProducto: nextProductMode,
  todos: verTodos,
  page: 1,
});

const clearFilterHref =
  universoId || origenId || productMode !== "all"
    ? "/explorar"
    : null;

if (!db) {
  console.warn("[explorar] DB binding no disponible.");
} else {
  /* ========================= */
  /* ORIGENES                  */
  /* ========================= */

  const origenesRes = await db
    .prepare(`
      SELECT id_etiqueta, nombre_etiqueta
      FROM etiquetas
      WHERE tipo_etiqueta = 'origen'
      ORDER BY nombre_etiqueta ASC
    `)
    .all();

  const origenRows = (origenesRes?.results || []) as EtiquetaRow[];

  origins = origenRows.map((o) => ({
    id: String(o.id_etiqueta),
    label: o.nombre_etiqueta,
  }));

  /* ========================= */
  /* UNIVERSOS                 */
  /* ========================= */

  const universosRes = await db
    .prepare(`
      SELECT id_universo, nombre_universo, img_universo
      FROM universos
      ORDER BY nombre_universo ASC
    `)
    .all();

  const universosRows = (universosRes?.results || []) as UniversoRow[];

  universos = universosRows.map((u) => ({
    id: String(u.id_universo),
    title: u.nombre_universo,
    imageUrl: u.img_universo ?? null,
  }));

  if (universoId) {
    universoNombre =
      universosRows.find(
        (u) => String(u.id_universo) === String(universoId)
      )?.nombre_universo ?? null;
  }

  if (origenId) {
    origenNombre =
      origenRows.find(
        (o) => String(o.id_etiqueta) === String(origenId)
      )?.nombre_etiqueta ?? null;
  }

  /* ========================= */
  /* FILTROS DE PERSONAJES    */
  /* ========================= */

  const whereClauses: string[] = [];
  const params: (string | number)[] = [];

  let joinOrigen = "";

  if (origenId) {
    joinOrigen = `
      INNER JOIN personajes_etiquetas pe
        ON pe.id_personaje = p.id_personaje
    `;

    whereClauses.push("pe.id_etiqueta = ?");
    params.push(origenId);
  }

  if (universoId) {
    whereClauses.push("p.id_universo = ?");
    params.push(universoId);
  }

  if (productMode === "cosplay") {
    whereClauses.push(`
      EXISTS (
        SELECT 1
        FROM productos prc
        WHERE prc.id_personaje = p.id_personaje
          AND NULLIF(TRIM(prc.tipo_cosplay), '') IS NOT NULL
      )
    `);
  }

  if (productMode === "figura") {
    whereClauses.push(`
      EXISTS (
        SELECT 1
        FROM productos prf
        WHERE prf.id_personaje = p.id_personaje
          AND NULLIF(TRIM(prf.tipo_cosplay), '') IS NULL
      )
    `);
  }

  const whereSql = whereClauses.length
    ? `WHERE ${whereClauses.join(" AND ")}`
    : "";

  /* ========================= */
  /* CONTEO Y PAGINACION      */
  /* ========================= */

  if (!discoveryMode) {
    const countSql = `
      SELECT
        ${
          origenId
            ? "COUNT(DISTINCT p.id_personaje)"
            : "COUNT(*)"
        } AS total
      FROM personajes p
      ${joinOrigen}
      ${whereSql}
    `;

    const countRes = params.length
      ? await db.prepare(countSql).bind(...params).first()
      : await db.prepare(countSql).first();

    totalCharacters = Number((countRes as any)?.total || 0);

    totalPages = Math.max(
      1,
      Math.ceil(totalCharacters / ITEMS_PER_PAGE)
    );

    currentPage = Math.min(requestedPage, totalPages);
  }

  /* ========================= */
  /* ROTACION DIARIA          */
  /* ========================= */

  /*
   * Un mismo día UTC produce el mismo inicio.
   * La selección avanza diez posiciones por día.
   *
   * No usamos ORDER BY RANDOM().
   * No ejecutamos COUNT(*) en descubrimiento.
   * No creamos tablas ni modificamos índices.
   */

  const dayNumber = Math.floor(Date.now() / 86400000);

  /*
   * Usamos el mayor ID existente para elegir
   * un punto de inicio variable.
   *
   * MAX(id_personaje) se puede resolver
   * eficientemente mediante la clave primaria.
   */
  let dailyStartId = 0;

  if (discoveryMode) {
    const maxRes = await db
      .prepare(`
        SELECT MAX(id_personaje) AS max_id
        FROM personajes
      `)
      .first();

    const maxId = Number((maxRes as any)?.max_id || 0);

    if (maxId > 0) {
      dailyStartId =
        ((dayNumber * DISCOVERY_ITEMS) % maxId) + 1;
    }
  }

  /* ========================= */
  /* CONSULTA DE PERSONAJES   */
  /* ========================= */

  /*
   * Descubrimiento:
   * recupera hasta diez personajes desde
   * el ID diario y continúa desde el inicio
   * si llega al final.
   *
   * Catálogo:
   * mantiene las 24 tarjetas paginadas.
   */

  const productCountFilter =
    productMode === "cosplay"
      ? "AND NULLIF(TRIM(pr.tipo_cosplay), '') IS NOT NULL"
      : productMode === "figura"
        ? "AND NULLIF(TRIM(pr.tipo_cosplay), '') IS NULL"
        : "";

  const enrichSql = (selectionSql: string) => `
    SELECT
      p.id_personaje,
      p.nombre_personaje,
      p.id_universo,

      (
        SELECT pi.url
        FROM personajes_imagenes pi
        WHERE pi.id_personaje = p.id_personaje
        ORDER BY pi.es_principal DESC, pi.orden ASC
        LIMIT 1
      ) AS img_personaje,

      (
        SELECT COUNT(*)
        FROM productos pr
        WHERE pr.id_personaje = p.id_personaje
        ${productCountFilter}
      ) AS productsCount

    FROM (
      ${selectionSql}
    ) p
  `;

  let personajes: PersonajeRow[] = [];

  if (discoveryMode) {
    const discoverySelection = `
      SELECT
        id_personaje,
        nombre_personaje,
        id_universo
      FROM personajes
      WHERE id_personaje >= ?
      ORDER BY id_personaje ASC
      LIMIT ?
    `;

    const firstRes = await db
      .prepare(enrichSql(discoverySelection))
      .bind(dailyStartId, DISCOVERY_ITEMS)
      .all();

    personajes = (firstRes?.results || []) as PersonajeRow[];

    /*
     * Si quedan menos de diez al final,
     * completamos desde el primer ID.
     */
    if (personajes.length < DISCOVERY_ITEMS) {
      const remaining = DISCOVERY_ITEMS - personajes.length;

      const wrapSelection = `
        SELECT
          id_personaje,
          nombre_personaje,
          id_universo
        FROM personajes
        WHERE id_personaje < ?
        ORDER BY id_personaje ASC
        LIMIT ?
      `;

      const wrapRes = await db
        .prepare(enrichSql(wrapSelection))
        .bind(dailyStartId, remaining)
        .all();

      personajes.push(
        ...((wrapRes?.results || []) as PersonajeRow[])
      );
    }
  } else {
    const pageSql = enrichSql(`
      SELECT
        p.id_personaje,
        p.nombre_personaje,
        p.id_universo
      FROM personajes p
      ${joinOrigen}
      ${whereSql}
      ORDER BY p.nombre_personaje ASC
      LIMIT ? OFFSET ?
    `);

    const offset = (currentPage - 1) * ITEMS_PER_PAGE;

    const personajesRes = await db
      .prepare(pageSql + " ORDER BY p.nombre_personaje ASC")
      .bind(...params, ITEMS_PER_PAGE, offset)
      .all();

    personajes =
      (personajesRes?.results || []) as PersonajeRow[];
  }

  categories = personajes.map((p) => ({
    meta: {
      id_personaje: p.id_personaje,
      title: p.nombre_personaje,
      slug: slugify(p.nombre_personaje),
      gallery: p.img_personaje
        ? [{ url: p.img_personaje }]
        : [],
    },
    productsCount: Number(p.productsCount || 0),
  }));
}

const meta = {
  title: origenNombre
    ? `Explorar: ${origenNombre}`
    : universoNombre
      ? `Explorar: ${universoNombre}`
      : discoveryMode
        ? "Descubre personajes"
        : "Explorar Personajes",
};
---

<Layout title={`${meta.title} | 3D Shop`}>
  <NewPageWrapper
    client:load
    meta={meta}
    categories={categories}
    universes={universos}
    origins={origins}
    activeOrigenId={origenId}
    activeUniversoId={universoId}
    clearFilterHref={clearFilterHref}
    origenNombre={origenNombre}
    productMode={productMode}
    productModeToggleHref={productModeToggleHref}
    currentPage={currentPage}
    totalPages={totalPages}
    totalCharacters={totalCharacters}
    itemsPerPage={ITEMS_PER_PAGE}
    discoveryMode={discoveryMode}
    allCharactersMode={verTodos}
  />
</Layout>
