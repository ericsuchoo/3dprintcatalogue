---
import Layout from "../../../layouts/Layout.astro";
import ProductPageWrapper from "../../../components/shop/product/PageWrapper";

type ProductoRow = {
  id_producto: number;
  nombre_producto: string;
  subtitulo?: string | null;
  descripcion?: string | null;
  img_producto?: string | null;
  unidades?: number | null;
  precio?: number | null;
  descuento?: number | null;
  id_proveedor?: number | null;
  id_universo?: number | null;
  id_personaje?: number | null;
  fecha_creacion?: string | null;
  fecha_modifica?: string | null;
  disclaimer?: string | null;
  aspectos_variables?: string | null;
  tipo_cosplay?: string | null;
};

function slugify(s: string) {
  return s
    .toString()
    .normalize("NFKD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase()
    .trim()
    .replace(/\s+/g, "-")
    .replace(/[^\w-]+/g, "")
    .replace(/--+/g, "-");
}

function productSlug(product: {
  nombre_producto: string;
  subtitulo?: string | null;
}) {
  const fullName = [product.nombre_producto, product.subtitulo]
    .filter(Boolean)
    .join(" ");

  return slugify(fullName);
}

const { slug } = Astro.params;

const productIdParam = Astro.url.searchParams.get("id");
const parsedProductId = productIdParam ? Number(productIdParam) : null;

const productId =
  parsedProductId &&
  Number.isInteger(parsedProductId) &&
  parsedProductId > 0
    ? parsedProductId
    : null;

const db = Astro.locals.runtime.env.DB as any;

if (!db) {
  return Astro.redirect("/404");
}

// CONTROL NSFW
const mostrarNSFW = false;

/* =========================================================
   1) RESOLVER PRODUCTO
   ========================================================= */

let product: ProductoRow | null = null;

/*
 * Ruta nueva:
 * /shop/wolverine-cowboy?id=123
 *
 * El ID es la identidad real del producto.
 */
if (productId) {
  const row = await db
    .prepare(`
      SELECT *
      FROM productos
      WHERE id_producto = ?
      LIMIT 1
    `)
    .bind(productId)
    .first();

  if (row) {
    product = row as ProductoRow;
  }

  if (!product) {
    return Astro.redirect("/404");
  }

  /*
   * Evita URLs incoherentes como:
   * /shop/batman?id=<id de Wolverine>
   */
  const expectedSlug = productSlug(product);

  if (slug !== expectedSlug) {
    return Astro.redirect(
      `/shop/${expectedSlug}?id=${product.id_producto}`
    );
  }
}

/*
 * Compatibilidad con URLs antiguas que todavía no tengan ?id=
 *
 * Primero intentamos nombre + subtítulo.
 * Después conservamos el comportamiento antiguo por nombre.
 */
if (!product) {
  const listRes = await db
    .prepare(`
      SELECT *
      FROM productos
      ORDER BY id_producto ASC
    `)
    .all();

  const list = (listRes?.results || []) as ProductoRow[];

  product =
    list.find((p) => productSlug(p) === slug) ??
    list.find((p) => slugify(p.nombre_producto) === slug) ??
    null;

  if (!product) {
    return Astro.redirect("/404");
  }

  /*
   * Canonizamos inmediatamente la URL antigua.
   * Desde aquí todo producto queda identificado por su ID.
   */
  return Astro.redirect(
    `/shop/${productSlug(product)}?id=${product.id_producto}`
  );
}

/* =========================================================
   2) EDICIONES + IMÁGENES
   ========================================================= */

const edRes = await db
  .prepare(`
    SELECT
      ep.id_edicion_producto,
      ep.id_edicion,
      e.nombre_edicion,
      ei.img_url,
      ei.orden,
      ei.nivel_contenido
    FROM edicion_producto ep
    INNER JOIN ediciones e
      ON e.id_edicion = ep.id_edicion
    LEFT JOIN edicion_imagenes ei
      ON ei.id_edicion_producto = ep.id_edicion_producto
    WHERE ep.id_producto = ?
    ORDER BY
      ep.id_edicion_producto ASC,
      ei.orden ASC
  `)
  .bind(product.id_producto)
  .all();

const rows = (edRes?.results || []) as any[];

const editionMap = new Map<number, any>();

for (const row of rows) {
  if (!editionMap.has(row.id_edicion_producto)) {
    editionMap.set(row.id_edicion_producto, {
      id_edicion: row.id_edicion,
      nombre_edicion: row.nombre_edicion,
      images: [],
    });
  }

  if (row.img_url) {
    editionMap.get(row.id_edicion_producto).images.push({
      url: row.img_url,
      nivel: row.nivel_contenido || "safe",
      orden: row.orden || 0,
    });
  }
}

const editions = Array.from(editionMap.values()).map((edition) => {
  edition.images.sort(
    (a: any, b: any) => a.orden - b.orden
  );

  const safeImage =
    edition.images.find(
      (img: any) => img.nivel !== "nsfw"
    )?.url ?? null;

  const firstImage =
    edition.images[0]?.url ?? null;

  return {
    id_edicion: edition.id_edicion,
    nombre_edicion: edition.nombre_edicion,

    img:
      safeImage ||
      firstImage ||
      product.img_producto ||
      null,

    images: edition.images.map((img: any) => ({
      url: img.url,
      nivel: img.nivel,
    })),
  };
});

/* =========================================================
   3) ESCALAS
   ========================================================= */

const scalesRes = await db
  .prepare(`
    SELECT
      ep.id_producto,
      ep.disponible,
      es.id_escala,
      es.nombre_escala,
      es.descripcion
    FROM escala_producto ep
    INNER JOIN escalas es
      ON es.id_escala = ep.id_escala
    WHERE ep.id_producto = ?
    ORDER BY es.id_escala ASC
  `)
  .bind(product.id_producto)
  .all();

const scales = (scalesRes?.results || []).map((row: any) => ({
  id_escala: row.id_escala,
  nombre_escala: row.nombre_escala,
  descripcion: row.descripcion ?? "",
  disponible: Number(row.disponible || 0) === 1,
}));

/* =========================================================
   4) PRODUCTOS RELACIONADOS
   ========================================================= */

let relatedRows: ProductoRow[] = [];

if (product.id_personaje) {
  const rel = await db
    .prepare(`
      SELECT *
      FROM productos
      WHERE id_producto != ?
        AND id_personaje = ?
      ORDER BY id_producto DESC
      LIMIT 8
    `)
    .bind(
      product.id_producto,
      product.id_personaje
    )
    .all();

  relatedRows = (rel?.results || []) as ProductoRow[];
}

/* =========================================================
   5) DATA FINAL
   ========================================================= */

const canonicalSlug = productSlug(product);

const modelId = [
  product.nombre_producto,
  product.subtitulo,
]
  .filter(Boolean)
  .join(" ")
  .toUpperCase();

const data = {
  meta: {
    id_producto: product.id_producto,

    title: product.nombre_producto,

    slug: canonicalSlug,

    model_id: modelId,

    subtitle: product.subtitulo ?? "",

    price: product.precio ?? 0,
    descuento: product.descuento ?? null,

    descripcion: product.descripcion ?? "",
    description: product.descripcion ?? "",

    disclaimer: product.disclaimer ?? "",
    aspectos_variables: product.aspectos_variables ?? "",

    tipo_cosplay: product.tipo_cosplay ?? "",

    personajeId: product.id_personaje ?? null,
    universoId: product.id_universo ?? null,
    proveedorId: product.id_proveedor ?? null,

    cover: product.img_producto
      ? { url: product.img_producto }
      : null,

    editions,
    scales,
  },

  otherProducts: relatedRows.map((pr) => ({
    id: pr.id_producto,

    slug: productSlug(pr),

    title: pr.nombre_producto,
    subtitle: pr.subtitulo ?? "",

    description: pr.descripcion ?? "",

    price: pr.precio ?? 0,
    discount: pr.descuento ?? 0,
    units: pr.unidades ?? null,

    coverUrl: pr.img_producto ?? "",
  })),
};
---

<Layout title={`${data.meta.title}${data.meta.subtitle ? ` ${data.meta.subtitle}` : ""} | DCimpress 3D`}>
  <ProductPageWrapper
    client:load
    data={data as any}
  />
</Layout>