
---
import Layout from "../../layouts/Layout.astro";
import ProductsPageWrapper from "../../components/shop/products/PageWrapper";

type ProductoRow = {
  id_producto: number | string;
  nombre_producto: string;
  subtitulo?: string | null;
  img_producto?: string | null;
  id_personaje?: number | null;
  id_universo?: number | null;
  id_proveedor?: number | null;
  nombre_etiqueta?: string | null;
};

type PersonajeRow = {
  id_personaje: number | string;
  nombre_personaje: string;
};

type UniversoRow = {
  id_universo: number | string;
  nombre_universo: string;
};

type ProveedorRow = {
  id_proveedor: number | string;
  nombre_proveedor: string;
};

type SortMode = "newest" | "price_asc" | "price_desc";
type ProductMode = "cosplay" | "figura" | null;

function slugify(value: string) {
  return value
    .toString()
    .normalize("NFKD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase()
    .trim()
    .replace(/\s+/g, "-")
    .replace(/[^\w-]+/g, "")
    .replace(/--+/g, "-");
}

function parsePositiveInt(value: string | null): number | null {
  if (!value) return null;

  const number = Number(value);

  return Number.isSafeInteger(number) && number > 0
    ? number
    : null;
}

function normalizeSort(_value: string | null): SortMode {
  // Los precios siguen desactivados.
  return "newest";
}

/* =========================================
   D1 Y PARAMETROS
========================================= */

const db = Astro.locals.runtime.env.DB as any;

const personajeId = parsePositiveInt(
  Astro.url.searchParams.get("personajeId")
);

const universoId = parsePositiveInt(
  Astro.url.searchParams.get("universoId")
);

const proveedorId = parsePositiveInt(
  Astro.url.searchParams.get("proveedorId")
);

// NUEVO: filtro por franquicia o categoria.
const etiquetaId = parsePositiveInt(
  Astro.url.searchParams.get("etiquetaId")
);

const requestedPage =
  parsePositiveInt(Astro.url.searchParams.get("page")) ?? 1;

const sort = normalizeSort(
  Astro.url.searchParams.get("sort")
);

const tipoProductoParam =
  Astro.url.searchParams.get("tipoProducto")?.trim() || null;

const tipoProducto: ProductMode =
  tipoProductoParam === "cosplay" ||
  tipoProductoParam === "figura"
    ? tipoProductoParam
    : null;

const personajeQuery =
  Astro.url.searchParams.get("personaje")?.trim() || null;

const personajeNombreParam =
  Astro.url.searchParams.get("characterName")?.trim() || null;

const ITEMS_PER_PAGE = 30;

/* =========================================
   ESTADO DE PAGINA
========================================= */

let resolvedPersonajeId = personajeId;

let personajeNombre: string | null = null;
let universoNombre: string | null = null;
let proveedorNombre: string | null = null;
let etiquetaNombre: string | null = null;

let totalProducts = 0;
let productos: ProductoRow[] = [];

let universos: UniversoRow[] = [];
let proveedores: ProveedorRow[] = [];

if (!db) {
  console.warn("[shop] DB binding no disponible.");
}

/* =========================================
   1. RESOLVER PERSONAJE POR NOMBRE
========================================= */

if (db && !resolvedPersonajeId && personajeQuery) {
  const exactRow = await db
    .prepare(`
      SELECT id_personaje, nombre_personaje
      FROM personajes
      WHERE LOWER(nombre_personaje) = LOWER(?)
      LIMIT 1
    `)
    .bind(personajeQuery)
    .first();

  if (exactRow) {
    resolvedPersonajeId = Number(
      (exactRow as PersonajeRow).id_personaje
    );

    personajeNombre =
      (exactRow as PersonajeRow).nombre_personaje;
  } else {
    const likeRow = await db
      .prepare(`
        SELECT id_personaje, nombre_personaje
        FROM personajes
        WHERE LOWER(nombre_personaje) LIKE LOWER(?)
        ORDER BY nombre_personaje ASC
        LIMIT 1
      `)
      .bind(`%${personajeQuery}%`)
      .first();

    if (likeRow) {
      resolvedPersonajeId = Number(
        (likeRow as PersonajeRow).id_personaje
      );

      personajeNombre =
        (likeRow as PersonajeRow).nombre_personaje;
    }
  }
}

/* =========================================
   2. NOMBRE DEL PERSONAJE
========================================= */

if (db && resolvedPersonajeId && !personajeNombre) {
  const personajeRes = await db
    .prepare(`
      SELECT nombre_personaje
      FROM personajes
      WHERE id_personaje = ?
      LIMIT 1
    `)
    .bind(resolvedPersonajeId)
    .first();

  personajeNombre =
    (personajeRes as { nombre_personaje?: string } | null)
      ?.nombre_personaje ?? null;
}

if (!personajeNombre && personajeNombreParam) {
  personajeNombre = personajeNombreParam;
}

/* =========================================
   3. FILTROS DINAMICOS
========================================= */

const whereClauses: string[] = [];
const whereParams: number[] = [];

if (resolvedPersonajeId) {
  whereClauses.push("p.id_personaje = ?");
  whereParams.push(resolvedPersonajeId);
}

if (universoId) {
  whereClauses.push("p.id_universo = ?");
  whereParams.push(universoId);
}

if (proveedorId) {
  whereClauses.push("p.id_proveedor = ?");
  whereParams.push(proveedorId);
}

/*
 * FILTRO POR ETIQUETA
 *
 * Busca productos relacionados mediante:
 *
 * 1. personajes_etiquetas
 * 2. productos_etiquetas
 *
 * EXISTS evita duplicar productos.
 * No utiliza LIKE ni busca texto.
 */

if (etiquetaId) {
  whereClauses.push(`
    (
      p.id_personaje IN (
        SELECT pe.id_personaje
        FROM personajes_etiquetas pe
        WHERE pe.id_etiqueta = ?
      )
      OR p.id_producto IN (
        SELECT pte.id_producto
        FROM productos_etiquetas pte
        WHERE pte.id_etiqueta = ?
      )
    )
  `);

  whereParams.push(etiquetaId, etiquetaId);
}

  

if (tipoProducto === "cosplay") {
  whereClauses.push(`
    NULLIF(TRIM(p.tipo_cosplay), '') IS NOT NULL
  `);
}

if (tipoProducto === "figura") {
  whereClauses.push(`
    NULLIF(TRIM(p.tipo_cosplay), '') IS NULL
  `);
}

const whereSql = whereClauses.length
  ? `WHERE ${whereClauses.join(" AND ")}`
  : "";

/* =========================================
   4. ORDENAMIENTO
========================================= */

const orderSql = `
  ORDER BY
    COALESCE(p.fecha_modifica, p.fecha_creacion) DESC,
    p.id_producto DESC
`;

/* =========================================
   5. CONTEO DE PRODUCTOS
========================================= */

if (db) {
  const countSql = `
    SELECT COUNT(*) AS total
    FROM productos p
    ${whereSql}
  `;

  const countRes = await db
    .prepare(countSql)
    .bind(...whereParams)
    .first();

  totalProducts = Number(
    (countRes as { total?: number } | null)?.total ?? 0
  );
}

const totalPages = Math.max(
  1,
  Math.ceil(totalProducts / ITEMS_PER_PAGE)
);

const currentPage = Math.min(
  requestedPage,
  totalPages
);

const offset =
  (currentPage - 1) * ITEMS_PER_PAGE;

/* =========================================
   6. PRODUCTOS PAGINADOS
   CONSULTA LIGERA
========================================= */

if (db) {
  const sql = `
    SELECT
      p.id_producto,
      p.nombre_producto,
      p.subtitulo,
      p.img_producto,
      p.id_personaje,
      p.id_universo,
      p.id_proveedor,

      (
        SELECT e.nombre_etiqueta
        FROM productos_etiquetas pe

        INNER JOIN etiquetas e
          ON e.id_etiqueta = pe.id_etiqueta

        WHERE pe.id_producto = p.id_producto

        ORDER BY
          CAST(
            COALESCE(
              pe.prioridad,
              e.prioridad,
              '9999'
            ) AS INTEGER
          ) ASC,
          e.nombre_etiqueta ASC

        LIMIT 1
      ) AS nombre_etiqueta

    FROM productos p

    ${whereSql}

    ${orderSql}

    LIMIT ? OFFSET ?
  `;

  const params = [
    ...whereParams,
    ITEMS_PER_PAGE,
    offset,
  ];

  const res = await db
    .prepare(sql)
    .bind(...params)
    .all();

  productos = (res?.results || []) as ProductoRow[];
  if (etiquetaId) {
  console.info("[shop:diagnostico-etiqueta]", {
    etiquetaId,
    personajeId: resolvedPersonajeId,
    universoId,
    proveedorId,
    tipoProducto,
    totalProducts,
    productosRecibidos: productos.length,
    ids: productos.map((p) => p.id_producto),
  });
}
}

/* =========================================
   7. UNIVERSOS Y PROVEEDORES
========================================= */

if (db) {
  const [universosRes, proveedoresRes] =
    await Promise.all([
      db
        .prepare(`
          SELECT id_universo, nombre_universo
          FROM universos
          ORDER BY nombre_universo ASC
        `)
        .all(),

      db
        .prepare(`
          SELECT id_proveedor, nombre_proveedor
          FROM proveedores
          ORDER BY nombre_proveedor ASC
        `)
        .all(),
    ]);

  universos =
    (universosRes?.results || []) as UniversoRow[];

  proveedores =
    (proveedoresRes?.results || []) as ProveedorRow[];
}

/* =========================================
   8. NOMBRES DE FILTROS
========================================= */

if (universoId) {
  universoNombre =
    universos.find(
      (u) => Number(u.id_universo) === universoId
    )?.nombre_universo ?? null;
}

if (proveedorId) {
  proveedorNombre =
    proveedores.find(
      (p) => Number(p.id_proveedor) === proveedorId
    )?.nombre_proveedor ?? null;
}

/*
 * Recuperar nombre solo cuando se selecciona
 * una etiqueta.
 */
if (db && etiquetaId) {
  const etiquetaRes = await db
    .prepare(`
      SELECT nombre_etiqueta
      FROM etiquetas
      WHERE id_etiqueta = ?
      LIMIT 1
    `)
    .bind(etiquetaId)
    .first();

  etiquetaNombre =
    (etiquetaRes as { nombre_etiqueta?: string } | null)
      ?.nombre_etiqueta ?? null;
}

const activeFilterLabels = [
  personajeNombre,
  universoNombre,
  proveedorNombre,
  etiquetaNombre,
].filter(
  (value): value is string => Boolean(value)
);

/* =========================================
   9. DATA PARA REACT
========================================= */

const data = {
  products: productos.map((pr) => ({
    id: pr.id_producto,

    slug: slugify(
      [pr.nombre_producto, pr.subtitulo]
        .filter(Boolean)
        .join(" ")
    ),

    title:
      pr.nombre_producto ??
      `Producto ${pr.id_producto}`,

    subtitle: pr.subtitulo ?? "",

    // Datos completos reservados para la ficha.
    description: "",
    units: null,

    // Precios desactivados temporalmente.
    price: null,
    priceMode: "quote" as const,
    discount: 0,

    coverUrl: pr.img_producto ?? "",

    // Relaciones reales conservadas.
    personajeId: pr.id_personaje ?? null,
    universoId: pr.id_universo ?? null,
    proveedorId: pr.id_proveedor ?? null,

    tagLabel:
      pr.nombre_etiqueta ?? "FIGURA 3D",
  })),

  genders: [],

  categories: universos.map((u) => ({
    title: u.nombre_universo,
    slug: String(u.id_universo),
  })),

  brands: proveedores.map((pr) => ({
    title: pr.nombre_proveedor,
    slug: String(pr.id_proveedor),
  })),

  initialPersonajeId: resolvedPersonajeId
    ? String(resolvedPersonajeId)
    : null,

  initialUniversoId: universoId
    ? String(universoId)
    : null,

  initialProveedorId: proveedorId
    ? String(proveedorId)
    : null,

  initialSort: sort,

  personajeNombre,
  universoNombre,
  proveedorNombre,

  activeFilterLabels,

  selectedCharacter: resolvedPersonajeId
    ? {
        id: String(resolvedPersonajeId),
        name:
          personajeNombre ??
          personajeQuery ??
          personajeNombreParam ??
          "",
      }
    : null,

  quickCharacterSuggestions: [],

  clearFilterHref:
    resolvedPersonajeId ||
    universoId ||
    proveedorId ||
    etiquetaId ||
    sort !== "newest" ||
    tipoProducto !== null
      ? "/shop"
      : null,

  pagination: {
    currentPage,
    totalPages,
    totalProducts,
    itemsPerPage: ITEMS_PER_PAGE,
    pageCount: productos.length,
    basePath: "/shop",

    personajeId: resolvedPersonajeId
      ? String(resolvedPersonajeId)
      : null,

    universoId: universoId
      ? String(universoId)
      : null,

    proveedorId: proveedorId
      ? String(proveedorId)
      : null,

    // Nuevo filtro para la paginacion.
    etiquetaId: etiquetaId
      ? String(etiquetaId)
      : null,

    sort,
  },
};
---

<Layout
  title={
    activeFilterLabels.length
      ? `Shop: ${activeFilterLabels.join(" / ")} | DCimpress 3D`
      : "Tienda | DCimpress 3D"
  }
>
  <ProductsPageWrapper client:load data={data} />
</Layout>
